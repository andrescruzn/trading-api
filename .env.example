# ======================================================================
# .env.example — Trading App
# ----------------------------------------------------------------------
# Copiar a `.env` y completar. Lo lee `app/common/config/settings.py`
# (única fuente de configuración; nunca `os.getenv` fuera de ahí).
#
# FORMATO:
# - Una variable por línea: CLAVE=valor
# - NO poner comentarios en la misma línea que una variable vacía
#   (`CLAVE=   # nota`): python-dotenv toma "# nota" como valor.
#   Los comentarios van siempre en su propia línea.
# - Booleanos: "true" / "false" (cualquier otro valor = false).
# ======================================================================


# ----------------------------------------------------------------------
# Entorno
# ----------------------------------------------------------------------
# development | testing | production
# Si falta, la app arranca como production (exige secretos reales).
# Fuera de development/testing: JWT_SECRET_KEY, CORS_ORIGINS y
# CREDENTIALS_SECRET_KEY son obligatorios, la cookie de auth se marca
# Secure (HTTPS) y /docs se desactiva.
APP_ENV=development

# Solo en development: devuelve el código de acceso en la respuesta del
# login para probar sin correo. false = el código solo llega por correo.
DEV_RETURN_OTP=true

# true SOLO si la API corre detrás de un proxy propio (Nginx, Caddy) que
# escribe X-Forwarded-For. Si no, cualquiera falsea su IP y se salta el
# rate limit. Recuerda también: uvicorn --forwarded-allow-ips=<ip del proxy>
TRUST_PROXY_HEADERS=false


# ----------------------------------------------------------------------
# OpenAPI / Docs
# ----------------------------------------------------------------------
API_TITLE=Trading App
API_VERSION=v1
# Prefijo de todas las rutas REST (la API es headless; /health queda en raíz).
# Si lo cambias, ajusta VITE_API_URL en .env.frontend.
API_PREFIX=/api


# ----------------------------------------------------------------------
# Base de datos (MySQL 8)
# ----------------------------------------------------------------------
# DB_PASSWORD se inserta tal cual en la URL de conexión: si contiene
# caracteres como @ : / # ? usar una contraseña sin ellos.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trading_ai
DB_USER=root
DB_PASSWORD=


# ----------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------
# Orígenes del frontend (React) que pueden llamar a la API con la cookie.
# Lista separada por comas. Vacío en development = localhost:5193/5173.
# El front llama a la API directo (VITE_API_URL, sin proxy), así que su origen
# tiene que estar aquí. Si lo defines en desarrollo, incluye http://localhost:5193.
# Obligatorio en producción.
# Ejemplo: https://app.midominio.com
CORS_ORIGINS=


# ----------------------------------------------------------------------
# JWT / Auth
# ----------------------------------------------------------------------
# Generar: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Vacío en development = clave insegura de desarrollo.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# Duración del token en minutos (default 60).
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60


# ----------------------------------------------------------------------
# Auth — Cookie HTTP-only
# ----------------------------------------------------------------------
# Secure se calcula solo (true fuera de development/testing).
AUTH_COOKIE_NAME=access_token
# Lax | Strict | None (None exige HTTPS)
# Lax funciona si el front y la API comparten sitio (localhost con distinto
# puerto en desarrollo, o subdominios app./api. del mismo dominio). Preferir
# siempre esa opción. Si el front vive en otro dominio, None (+ HTTPS); en ese
# caso la defensa CSRF es la verificación de Origin contra CORS_ORIGINS.
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_PATH=/
# Vacío = dominio del servidor. Para subdominios: .midominio.com
AUTH_COOKIE_DOMAIN=


# ----------------------------------------------------------------------
# Auth — IDs de roles (tabla `roles`)
# ----------------------------------------------------------------------
# Cambiar solo si cambian los IDs en la base de datos.
# Super admin = propietarios (Andrés y Dayron); socio = solo lectura.
AUTH_SUPER_ADMIN_ROLE_ID=2
AUTH_INVESTOR_ROLE_ID=3
AUTH_PARTNER_ROLE_ID=4


# ----------------------------------------------------------------------
# Credenciales de exchange (cifrado Fernet)
# ----------------------------------------------------------------------
# Cifra api_key/api_secret de las cuentas de exchange.
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Vacío = clave fija de desarrollo (INSEGURA). Obligatoria en producción.
# Rotar: pon la clave nueva aquí y la anterior en CREDENTIALS_PREVIOUS_KEYS
# (se sigue pudiendo descifrar) hasta re-cifrar todas las cuentas.
CREDENTIALS_SECRET_KEY=


# ----------------------------------------------------------------------
# SMTP (Mailer — envío de OTP)
# ----------------------------------------------------------------------
SMTP_HOST=smtp.tu-proveedor.com
# 465 con SSL, o 587 con STARTTLS (activar solo uno de los dos).
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
SMTP_USERNAME=no-reply@midominio.com
SMTP_PASSWORD=
# Vacío = SMTP_USERNAME
SMTP_FROM_EMAIL=no-reply@midominio.com
SMTP_FROM_NAME=Trading AI


# ----------------------------------------------------------------------
# LLM — Pool de servicios de IA (rotación + failover)
# ----------------------------------------------------------------------
# Orden de rotación: cada análisis usa el siguiente servicio; si falla,
# se prueba el siguiente. Los servicios sin API key se omiten.
# Valores: groq | gemini | ollama
LLM_SERVICES=groq,gemini,ollama
GROQ_API_KEY=
# Vacío = moonshotai/kimi-k2-instruct-0905
GROQ_MODEL=
# Google AI Studio: la key se crea en aistudio.google.com
GEMINI_API_KEY=
# Vacío = gemini-3.5-flash-lite (capa gratuita: 15 RPM · 500 peticiones/día, ver dashboard de AI Studio)
GEMINI_MODEL=
# Ollama Cloud: la key se crea en ollama.com/settings/keys
OLLAMA_API_KEY=
# Vacío = nemotron-3-ultra (nombre de ollama.com/api/tags, sin :cloud)
OLLAMA_MODEL=
# Segundos por llamada antes de pasar al siguiente servicio (nemotron-3-ultra puede pasar de 30).
LLM_TIMEOUT_SECONDS=60
# 0.0 (determinístico) – 1.0 (creativo). Recomendado 0.1.
LLM_TEMPERATURE=0.1
# Gemini 3 gasta parte de este tope en razonar: con menos de 4096 el JSON puede llegar cortado.
LLM_MAX_TOKENS=4096


# Claves anteriores separadas por comas (solo para descifrar durante una rotación)
CREDENTIALS_PREVIOUS_KEYS=


# ----------------------------------------------------------------------
# Código de acceso (OTP)
# ----------------------------------------------------------------------
# Secreto del HMAC de los códigos. Vacío = usa JWT_SECRET_KEY; mejor separarlos.
OTP_HMAC_SECRET=
# Intentos fallidos antes de invalidar el código vigente
OTP_MAX_FAILED_ATTEMPTS=5


# ----------------------------------------------------------------------
# Agente de trading
# ----------------------------------------------------------------------
# Riesgo/beneficio mínimo para aprobar una señal (regla de negocio: 2:1).
AGENT_MIN_RR_RATIO=2.0
# Vacío = prompt maestro por defecto (analyze_service.py).
AGENT_MASTER_PROMPT=
# La entrada que propone la IA no puede alejarse del último cierre más de N × ATR(14).
AGENT_MAX_ENTRY_ATR_DISTANCE=1.0
# Análisis de la IA por usuario y minuto (cada uno es una llamada de pago al LLM).
AGENT_ANALYSES_PER_MINUTE=6


# ----------------------------------------------------------------------
# Trading — Salvaguardas de ejecución
# ----------------------------------------------------------------------
# Kill switch global: false = no sale ninguna orden (paper ni live).
TRADING_ENABLED=true
# false = solo órdenes paper. Activar live solo tras validar el edge en paper.
TRADING_LIVE_ENABLED=false
# Valor máximo (cantidad × precio) de una compra, en moneda de cotización.
# 0 = sin tope global (cada agente puede fijar risk_params.max_notional).
ORDER_MAX_NOTIONAL=10000
# Crear, cancelar o aprobar órdenes por usuario y minuto
ORDER_REQUESTS_PER_MINUTE=20
# En live, el stop loss de las posiciones abiertas desde una señal queda como
# orden en el exchange (si lo soporta). false = lo vigila solo el scheduler.
ORDER_NATIVE_STOP_LOSS=true
# true = usa la testnet del exchange (claves de testnet): prueba live sin dinero real.
LIVE_USE_SANDBOX=false


# ----------------------------------------------------------------------
# Modo de ejecución de los agentes (manual / con aprobación / automático)
# ----------------------------------------------------------------------
# Permite agentes Automáticos en live (órdenes reales sin aprobación humana).
TRADING_LIVE_AUTO_ENABLED=false
# Minutos para aprobar una señal si el agente no fija los suyos.
SIGNAL_APPROVAL_TTL_MINUTES=60
# Timeframe mínimo (segundos) para señales automáticas. 900 = 15m.
SIGNALS_AUTO_MIN_TIMEFRAME_SECONDS=900
# Análisis automáticos de la IA por usuario y día (coste del LLM).
AGENT_MAX_AUTO_ANALYSES_PER_DAY=96


# ----------------------------------------------------------------------
# Alertas — Canales de notificación
# ----------------------------------------------------------------------
# Token de @BotFather y chat por defecto. Vacío = canal Telegram inactivo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
# @usuario del bot (sin @): arma el enlace t.me/<bot>?start=... para vincular chats.
TELEGRAM_BOT_USERNAME=
# off | polling (desarrollo, sin URL pública) | webhook (producción)
TELEGRAM_UPDATES_MODE=off
# secret_token de setWebhook; obligatorio con TELEGRAM_UPDATES_MODE=webhook.
# Generar: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# URL del frontend para los enlaces de Telegram (solo https se muestra como botón).
FRONTEND_URL=http://localhost:5193
DESKTOP_NOTIFICATIONS_ENABLED=false
# Reglas de precio, PnL y drawdown (se revisan en cada ciclo del scheduler):
# mientras la condición siga, vuelven a avisar como máximo cada N minutos.
ALERT_REPEAT_MINUTES=60


# ----------------------------------------------------------------------
# Scheduler — Actualización automática de velas y features
# ----------------------------------------------------------------------
# false para tests o ejecución manual.
SCHEDULER_ENABLED=true
# Cada cuántos segundos corre el ciclo.
SCHEDULER_INTERVAL_SECONDS=60
# Velas a conservar por símbolo+timeframe (500 alcanza para EMA200).
SCHEDULER_RETENTION_CANDLES=500

# ----------------------------------------------------------------------
# Billetera de la plataforma (fondo común)
# ----------------------------------------------------------------------
# Moneda en que se valora la billetera y se lleva la contabilidad del fondo.
WALLET_BASE_ASSET=USDT
# Cada cuántos segundos el scheduler lee el saldo del exchange (mínimo 60).
# La API key de la billetera necesita permiso de LECTURA; nunca de retiro.
WALLET_SYNC_INTERVAL_SECONDS=300
# Horas que un medio de pago nuevo (banco / Nequi) espera antes de recibir retiros.
PAYOUT_METHOD_COOLDOWN_HOURS=48
