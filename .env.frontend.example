# =========================
# Frontend (Vite) — copiar a .env.frontend
# =========================
# Solo las variables con prefijo VITE_ llegan al navegador: nunca pongas secretos aquí.

# Base de la API REST. En desarrollo "/api" pasa por el proxy de Vite (mismo origen,
# la cookie de sesión viaja sin CORS). En producción: la URL pública, p. ej.
# https://trading.midominio.com/api (idealmente el mismo dominio que el front).
VITE_API_URL=/api

# Solo desarrollo: a dónde reenvía el proxy de Vite las peticiones /api.
VITE_API_PROXY_TARGET=http://localhost:8000
