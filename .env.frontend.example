# =========================
# Frontend (Vite) — copiar a .env.frontend
# =========================
# Solo las variables con prefijo VITE_ llegan al navegador: nunca pongas secretos aquí.

# URL completa de la API REST. El front la llama directo (sin proxy), así que su
# origen debe estar en CORS_ORIGINS del .env del backend.
# En desarrollo usa el mismo host que abres en el navegador (localhost, no
# 127.0.0.1): si no, la cookie de sesión SameSite=Lax no viaja.
# En producción: la URL pública, p. ej. https://api.midominio.com/api
VITE_API_URL=http://localhost:8000/api
