# =========================
# Python
# =========================
__pycache__/
*.py[cod]

# =========================
# Virtual environment
# =========================
.venv/

# =========================
# Environment variables
# =========================
.env
.env.*
!.env.example

# =========================
# Logs
# =========================
*.log
logs/

# =========================
# Tests / coverage
# =========================
.pytest_cache/
.coverage*
htmlcov/

# =========================
# Type check / lint caches
# =========================
.mypy_cache/
.pyright/
.ruff_cache/

# =========================
# IDEs / Editors
# =========================
.vscode/
.idea/

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db

# =========================
# Instance folder (local-only)
# =========================
instance/*
!instance/.gitkeep

# =========================
# Claude Code
# =========================
# Ignorar configuración local (settings, cache, etc.)
.claude/*
# Pero compartir el contexto del proyecto con el equipo
!.claude/main_instructions.md
!.claude/db_schema.sql
!.claude/skills/
!.claude/skills/**
!.claude/memory/
!.claude/memory/**
# settings.local.json siempre local — no commitear
.claude/settings.local.json
# CLAUDE.md es el archivo de entrada — compartirlo
!CLAUDE.md